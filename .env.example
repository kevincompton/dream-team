# Hedera Network Configuration
HEDERA_NETWORK=testnet
HEDERA_EVM_RPC_URL=https://testnet.hashio.io/api
# Opcional: lista de RPCs separada por comas para fallback automático (quorum=1)
# HEDERA_EVM_RPC_URLS=https://testnet.hashio.io/api,https://another-rpc.example/api
HEDERA_EVM_CHAIN_ID=296
HEDERA_ACCOUNT_ID=0.0.123456
HEDERA_PRIVATE_KEY=302e020100300506032b657004220420...

# Contract Address (se llenará después del despliegue)
KNOWLEDGE_POOL_CONTRACT_ADDRESS=

# Dashboard LIVE configuration
# false = usa datos reales de Hedera/Mirror Node
# true  = modo demo con mocks
NEXT_PUBLIC_USE_MOCK_DATA=false

# Topic de HCS donde publican los agentes (formato 0.0.x)
NEXT_PUBLIC_HCS_TOPIC_ID=

# HCS-2 Knowledge registry (run "npm run create:knowledge-registry" once; Validator registers topics here)
KNOWLEDGE_REGISTRY_TOPIC_ID=
# Knowledge inbound HIP-991 topic (run "npm run create:knowledge-inbound-topic" to provision)
KNOWLEDGE_INBOUND_TOPIC_ID=

# Sensor Agent (separate account -- provisioned by sensor dev)
# Run "npm run create:sensor-topic" to provision outbound HCS-2 storage topic
# Run "npm run create:sensor-inbound-topic" to provision inbound HIP-991 paid topic
SENSOR_ACCOUNT_ID=
SENSOR_PRIVATE_KEY=
SENSOR_TOPIC_ID=
SENSOR_INBOUND_TOPIC_ID=
SENSOR_REGISTRY_TOPIC_ID=

# Cuentas Hedera de agentes separadas por comas (proposer,executor,validator)
NEXT_PUBLIC_AGENT_ACCOUNT_IDS=0.0.111111,0.0.222222,0.0.333333

# Dirección EVM del contrato para lecturas on-chain desde el dashboard
NEXT_PUBLIC_KNOWLEDGE_POOL_CONTRACT_ADDRESS=

# Wallet del usuario para filtrar User History (opcional)
NEXT_PUBLIC_USER_WALLET=

# Recompensas por tarea (en HBAR; ejemplo: 1, 0.1, 0.001)
# REWARD_PROPOSER_HBAR=0.001
# REWARD_VALIDATOR_HBAR=0.001
# REWARD_EXECUTOR_HBAR=0.001

# Fondeo del pool (en HBAR; ejemplo: 2)
# FUND_AMOUNT_HBAR=0.1

# LLM Configuration (routed through Vercel AI Gateway)
OPENAI_API_KEY=your-key-here

# Node Configuration
NODE_ENV=development

# Agent polling throttling (reduce llamadas RPC para evitar 429/1015)
# EXECUTOR_POLL_SECONDS=45
# EXECUTOR_MAX_ITEMS_PER_CYCLE=8
# VALIDATOR_POLL_SECONDS=60
# VALIDATOR_MAX_ITEMS_PER_CYCLE=8

# Dashboard debugging
# Activa logs de salud en consola del navegador
# NEXT_PUBLIC_DASHBOARD_DEBUG=true

# MCP Server
MCP_PORT=3001
# Blocking wait window for /research endpoint (milliseconds)
# MCP_BLOCKING_TIMEOUT_MS=180000

# ask-hive timeout retry behavior (OpenClaw skill)
# HIVE_RETRY_ON_TIMEOUT=true
# HIVE_RETRY_DELAY_MS=20000
# Force MCP/OpenClaw final answers to English
# HIVE_FORCE_ENGLISH=true

# HIP-991 Knowledge Topics (auto-populated by validator)
# Format: JSON array of {knowledgeId, topicId, fee}
HIP991_TOPICS=[]

# Dashboard multi-topic mapping (for LIVE HCS feed aggregation)
# Format: JSON array of {knowledgeId, topicId}
# Example: [{"knowledgeId":12,"topicId":"0.0.123456"},{"knowledgeId":13,"topicId":"0.0.123457"}]
NEXT_PUBLIC_HIP991_TOPICS=[]

# OpenClaw Integration (optional)
OPENCLAW_WEBHOOK_SECRET=""
OPENCLAW_GATEWAY_URL="http://localhost:18789"

# Telegram Pulse Bridge (run "npm run get:telegram-chat-id" to discover CHAT_ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# HIP-1215 Pulse Scheduling (servo = main pulse, sensor = reactive to servo)
# PULSE_INTERVAL_SECONDS=30
# SENSOR_INTERVAL_SECONDS=15
# DEPLOY_FUND_HBAR=5
